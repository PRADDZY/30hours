{
  "name": "30hours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-local-env.mjs dev --hostname 0.0.0.0",
    "build": "node scripts/with-local-env.mjs build",
    "start": "node scripts/with-local-env.mjs start --hostname 0.0.0.0",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:secrets": "node scripts/upload-cloudflare-secrets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:audio": "node --env-file=.env.local scripts/generate-demo.mjs",
    "demo:pune-route": "node scripts/update-pune-demo-route.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "idb": "^8.0.4",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "openai": "^7.43.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
